@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Сброс пароля";
    Layout = "_AuthLayout";
}

<div class="auth-container">
    <h1 class="auth-title">Новый пароль</h1>

    <form asp-action="ResetPassword" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <input asp-for="Token" type="hidden" />

        <div class="form-group">
            <label asp-for="NewPassword">Новый пароль</label>
            <input asp-for="NewPassword" type="password" placeholder="Минимум 6 символов" />
            <span asp-validation-for="NewPassword" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="ConfirmPassword">Подтверждение пароля</label>
            <input asp-for="ConfirmPassword" type="password" placeholder="Повторите пароль" />
            <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
        </div>

        <button type="submit" class="btn-submit">Сохранить пароль</button>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}