@{
    ViewData["Title"] = "Восстановление пароля";
    Layout = "_AuthLayout";
}

<div class="auth-container">
    <h1 class="auth-title">Восстановление пароля</h1>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="validation-summary-errors"></div>
    }

    <form asp-action="ForgotPassword" method="post">
        <div class="form-group">
            <label>Email</label>
            <input type="email" name="email" placeholder="Введите ваш email" required />
        </div>

        <button type="submit" class="btn-submit">Отправить ссылку</button>
    </form>

    <p class="auth-link">
        <a asp-action="Login">Вернуться ко входу</a>
    </p>
</div>