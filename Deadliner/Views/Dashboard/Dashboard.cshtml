@model DashboardViewModel
@{
    ViewData["Title"] = "Дашборд";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/date-picker.css" asp-append-version="true" />
}

<div class="dashboard">
    @if (TempData["Error"] != null)
    {
        <div class="validation-summary-errors">@TempData["Error"]</div>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="validation-summary-errors"></div>
    }
    <div class="dashboard__header">
        <h1 class="dashboard__title">Дашборд</h1>
        <div class="dashboard__actions">
            <form class="planner-form" asp-action="DownloadPdf" method="get">
                <span class="planner-form__label">Планер:</span>
                <div class="date-picker" data-date-picker>
                    <input type="hidden" name="fromDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    <button type="button" class="date-picker__trigger" aria-label="Дата начала"></button>
                    <div class="date-picker__popup" hidden>
                        <div class="date-picker__header">
                            <span class="date-picker__month"></span>
                            <div class="date-picker__nav">
                                <button type="button" class="date-picker__prev" aria-label="Предыдущий месяц">‹</button>
                                <button type="button" class="date-picker__next" aria-label="Следующий месяц">›</button>
                            </div>
                        </div>
                        <div class="date-picker__weekdays">
                            @foreach (var day in new[] { "Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс" })
                            {
                                <span class="date-picker__weekday">@day</span>
                            }
                        </div>
                        <div class="date-picker__grid"></div>
                    </div>
                </div>
                <span class="planner-form__sep">—</span>
                <div class="date-picker" data-date-picker>
                    <input type="hidden" name="toDate" value="@DateTime.Today.AddDays(6).ToString("yyyy-MM-dd")" required />
                    <button type="button" class="date-picker__trigger" aria-label="Дата окончания"></button>
                    <div class="date-picker__popup" hidden>
                        <div class="date-picker__header">
                            <span class="date-picker__month"></span>
                            <div class="date-picker__nav">
                                <button type="button" class="date-picker__prev" aria-label="Предыдущий месяц">‹</button>
                                <button type="button" class="date-picker__next" aria-label="Следующий месяц">›</button>
                            </div>
                        </div>
                        <div class="date-picker__weekdays">
                            @foreach (var day in new[] { "Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс" })
                            {
                                <span class="date-picker__weekday">@day</span>
                            }
                        </div>
                        <div class="date-picker__grid"></div>
                    </div>
                </div>
                <button type="submit" class="btn btn--primary btn--small">Скачать PDF</button>
            </form>
            <a class="btn btn--primary" asp-controller="Task" asp-action="Create">+ Новая задача</a>
        </div>
    </div>

    @if (Model.TaskGroups == null || !Model.TaskGroups.Any())
    {
        <div class="dashboard__empty">
            <p>У вас пока нет задач.</p>
            <a class="btn btn--primary" asp-controller="Task" asp-action="Create">Создать первую задачу</a>
        </div>
    }
    else
    {
        <div class="counters">
            <div class="counter counter--active">
                <span class="counter__value">@Model.ActiveCount</span>
                <span class="counter__label">Активные</span>
            </div>
            <div class="counter counter--overdue">
                <span class="counter__value">@Model.OverdueCount</span>
                <span class="counter__label">Просрочены</span>
            </div>
            <div class="counter counter--completed">
                <span class="counter__value">@Model.CompletedCount</span>
                <span class="counter__label">Выполнены</span>
            </div>
            <div class="counter counter--cancelled">
                <span class="counter__value">@Model.CancelledCount</span>
                <span class="counter__label">Отменены</span>
            </div>
        </div>

        <div class="dashboard__limit">
            <span>Показывать задач:</span>
            <div class="limit-input">
                <button type="button" class="limit-input__btn" onclick="changeLimit(-1)">−</button>
                <input type="number" id="limitInput" value="@(Context.Request.Query["limit"].FirstOrDefault() ?? "10")"
                       min="1" max="100" class="limit-input__field" onchange="applyLimit()" />
                <button type="button" class="limit-input__btn" onclick="changeLimit(1)">+</button>
            </div>
        </div>

        <div class="task-groups">
            @foreach (var group in Model.TaskGroups)
            {
                <div class="task-group">
                    <div class="task-group__header">
                        <span class="task-group__dot" style="background-color: @group.ColorHex"></span>
                        <h2 class="task-group__title">
                            <a asp-controller="Task" asp-action="Index" asp-route-tagId="@group.TagId">
                                @group.TagName
                            </a>
                        </h2>
                        <span class="task-group__count">Количество задач: @group.Tasks.Count</span>
                    </div>

                    <div class="task-group__list">
                        @foreach (var task in group.Tasks)
                        {
                            <a class="task-card @(task.IsOverdue ? "task-card--overdue" : "")"
                               asp-controller="Task" asp-action="Details" asp-route-taskId="@task.Id">
                                <div class="task-card__left">
                                    <span class="task-card__priority priority--@task.Priority.ToString().ToLower()">
                                        @task.Priority
                                    </span>
                                </div>
                                <div class="task-card__center">
                                    <span class="task-card__title">@task.Title</span>
                                    @if (task.Deadline != null)
                                    {
                                        <span class="task-card__deadline @(task.IsOverdue ? "task-card__deadline--overdue" : "")">
                                            @task.Deadline?.ToString("dd MMM yyyy")
                                        </span>
                                    }
                                </div>
                                <div class="task-card__right">
                                    @if (task.IsOverdue)
                                    {
                                        <span class="badge badge--overdue">Просрочена</span>
                                    }
                                </div>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/date-picker.js" asp-append-version="true"></script>
    <script>
        function changeLimit(delta) {
            const input = document.getElementById('limitInput');
            let value = parseInt(input.value) || 10;
            value = Math.max(1, Math.min(100, value + delta));
            input.value = value;
            applyLimit();
        }

        function applyLimit() {
            const input = document.getElementById('limitInput');
            let value = parseInt(input.value);
    
            if (isNaN(value) || value < 1) {
                value = 1;
                input.value = 1;
            }
    
            window.location.href = '?limit=' + value;
        }
    </script>
}